# Copy to .env (git-ignored) for local dev, or set these on the hosting
# platform (Railway, Render, Fly, …) for staging/production.

# Postgres connection string. Falls back to a localhost database when unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cornerstone

# Admin login. When both are set the app creates (or updates) this account as an
# active admin on every boot, so the login works on a fresh database AND on one
# that was seeded earlier. The login screen signs in by email, so ADMIN_EMAIL is
# the username. Password must be at least 6 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# Optional: SendGrid API key for outgoing email.
# SENDGRID_API_KEY=
